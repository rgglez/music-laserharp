#: src/client.ts:41
msgid "Could not restore the local settings; using the initial presets."
msgstr "Die lokalen Einstellungen konnten nicht wiederhergestellt werden; die Anfangs-Presets werden verwendet."

#: src/client.ts:120 src/template.ts:22
msgid "Enable sound"
msgstr "Ton aktivieren"

#: src/client.ts:124
msgid "Sound is off. Press Enable sound to start."
msgstr "Ton ist aus. Drücke Ton aktivieren, um zu beginnen."

#: src/client.ts:125
msgid "WebGL is not available. You can play with the note buttons."
msgstr "WebGL ist nicht verfügbar. Du kannst mit den Notentasten spielen."

#: src/client.ts:131
msgid "Preparing the sound…"
msgstr "Ton wird vorbereitet…"

#: src/client.ts:143
msgid "Disable sound"
msgstr "Ton deaktivieren"

#: src/client.ts:147
msgid "Ready. Press and hold a beam or play a note."
msgstr "Bereit. Halte einen Strahl gedrückt oder spiele eine Note."

#: src/client.ts:148
msgid "Ready. Play with the note buttons."
msgstr "Bereit. Spiele mit den Notentasten."

#: src/client.ts:154
msgid "Could not enable audio. Press Enable sound to try again."
msgstr "Audio konnte nicht aktiviert werden. Drücke Ton aktivieren, um es erneut zu versuchen."

#: src/client.ts:175
#, javascript-format
msgid "Key %1$s: %2$s"
msgstr "Taste %1$s: %2$s"

#: src/client.ts:181
#, javascript-format
msgid "Play %1$s, beam %2$s, %3$s"
msgstr "%1$s spielen, Strahl %2$s, %3$s"

#: src/client.ts:229
msgid "Changes work on this page, but the browser does not allow saving them for another visit."
msgstr "Die Änderungen funktionieren auf dieser Seite, aber der Browser erlaubt nicht, sie für einen späteren Besuch zu speichern."

#: src/client.ts:504
msgid "The graphics context was lost. Reload the page to restore the beams."
msgstr "Der Grafikkontext ging verloren. Lade die Seite neu, um die Strahlen wiederherzustellen."

#: src/editor.ts:70
#, javascript-format
msgid "Beam %1$s: note"
msgstr "Strahl %1$s: Note"

#: src/editor.ts:78
#, javascript-format
msgid "Beam %1$s: color"
msgstr "Strahl %1$s: Farbe"

#: src/editor.ts:105
#, javascript-format
msgid "%1$s of %2$s custom presets. Changes apply when you save."
msgstr "%1$s von %2$s eigenen Presets. Änderungen werden beim Speichern übernommen."

#: src/editor.ts:119
msgid "Untitled"
msgstr "Ohne Namen"

#: src/editor.ts:172
#, javascript-format
msgid "Preset %1$s"
msgstr "Preset %1$s"

#: src/editor.ts:208
#, javascript-format
msgid "Check the names (1–40 characters), short names (1–%1$s), notes, and colors of all presets."
msgstr "Prüfe die Namen (1–40 Zeichen), Kurznamen (1–%1$s), Noten und Farben aller Presets."

#: src/index.ts:37 src/template.ts:19
msgid "Laser harp"
msgstr "Laserharfe"

#: src/index.ts:47
msgid "Could not load the instrument. Reload the page to try again."
msgstr "Das Instrument konnte nicht geladen werden. Lade die Seite neu, um es erneut zu versuchen."

#: src/presets.ts:14
msgid "Red"
msgstr "Rot"

#: src/presets.ts:15
msgid "Green"
msgstr "Grün"

#: src/presets.ts:16
msgid "Yellow"
msgstr "Gelb"

#: src/presets.ts:17
msgid "Orange"
msgstr "Orange"

#: src/presets.ts:18
msgid "White"
msgstr "Weiß"

#: src/presets.ts:19
msgid "Blue"
msgstr "Blau"

#: src/template.ts:25
msgid "Enable sound, then press and hold a beam with the mouse or a finger; you can slide between beams. You can also focus a note and hold Space or Enter. Hovering without pressing makes no sound."
msgstr "Aktiviere den Ton und halte einen Strahl mit der Maus oder dem Finger gedrückt; du kannst zwischen den Strahlen gleiten. Du kannst auch eine Note fokussieren und Leertaste oder Enter halten. Bloßes Überfahren mit der Maus erzeugt keinen Ton."

#: src/template.ts:26
msgid "With the harp focused, hold keys 1 to 0 to play the beams from left to right; 0 is the tenth beam."
msgstr "Wenn die Harfe fokussiert ist, halte die Tasten 1 bis 0, um die Strahlen von links nach rechts zu spielen; 0 ist der zehnte Strahl."

#: src/template.ts:30
msgid "PLAY THE LIGHT"
msgstr "SPIEL DAS LICHT"

#: src/template.ts:33
msgid "Harp notes, from left to right"
msgstr "Noten der Harfe, von links nach rechts"

#: src/template.ts:34
msgid "Select preset"
msgstr "Preset auswählen"

#: src/template.ts:36 src/template.ts:42
msgid "Presets"
msgstr "Presets"

#: src/template.ts:37
msgid "Volume"
msgstr "Lautstärke"

#: src/template.ts:39
msgid "Loading the instrument…"
msgstr "Instrument wird geladen…"

#: src/template.ts:40
msgid "Configure presets"
msgstr "Presets konfigurieren"

#: src/template.ts:43
#, javascript-format
msgid "Up to five custom presets of %1$s to %2$s beams. The original RV2 preset keeps its nine notes and is always available."
msgstr "Bis zu fünf eigene Presets mit %1$s bis %2$s Strahlen. Das originale RV2-Preset behält seine neun Noten und ist immer verfügbar."

#: src/template.ts:44
msgid "Custom preset"
msgstr "Eigenes Preset"

#: src/template.ts:46
msgid "New preset"
msgstr "Neues Preset"

#: src/template.ts:47
msgid "Delete preset"
msgstr "Preset löschen"

#: src/template.ts:50
msgid "Preset settings"
msgstr "Preset-Einstellungen"

#: src/template.ts:51
msgid "Name"
msgstr "Name"

#: src/template.ts:52
msgid "Short name (button)"
msgstr "Kurzname (Schaltfläche)"

#: src/template.ts:53
msgid "Number of beams"
msgstr "Anzahl der Strahlen"

#: src/template.ts:58
msgid "Cancel"
msgstr "Abbrechen"

#: src/template.ts:59
msgid "Save changes"
msgstr "Änderungen speichern"
