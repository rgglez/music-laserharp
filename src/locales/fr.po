#: src/client.ts:41
msgid "Could not restore the local settings; using the initial presets."
msgstr "Impossible de restaurer la configuration locale ; les préréglages initiaux sont utilisés."

#: src/client.ts:120 src/template.ts:22
msgid "Enable sound"
msgstr "Activer le son"

#: src/client.ts:124
msgid "Sound is off. Press Enable sound to start."
msgstr "Son désactivé. Appuyez sur Activer le son pour commencer."

#: src/client.ts:125
msgid "WebGL is not available. You can play with the note buttons."
msgstr "WebGL n'est pas disponible. Vous pouvez jouer avec les boutons de notes."

#: src/client.ts:131
msgid "Preparing the sound…"
msgstr "Préparation du son…"

#: src/client.ts:143
msgid "Disable sound"
msgstr "Désactiver le son"

#: src/client.ts:147
msgid "Ready. Press and hold a beam or play a note."
msgstr "Prêt. Maintenez un rayon enfoncé ou jouez une note."

#: src/client.ts:148
msgid "Ready. Play with the note buttons."
msgstr "Prêt. Jouez avec les boutons de notes."

#: src/client.ts:154
msgid "Could not enable audio. Press Enable sound to try again."
msgstr "Impossible d'activer l'audio. Appuyez sur Activer le son pour réessayer."

#: src/client.ts:175
#, javascript-format
msgid "Key %1$s: %2$s"
msgstr "Touche %1$s : %2$s"

#: src/client.ts:181
#, javascript-format
msgid "Play %1$s, beam %2$s, %3$s"
msgstr "Jouer %1$s, rayon %2$s, %3$s"

#: src/client.ts:229
msgid "Changes work on this page, but the browser does not allow saving them for another visit."
msgstr "Les modifications fonctionnent sur cette page, mais le navigateur ne permet pas de les enregistrer pour une prochaine visite."

#: src/client.ts:504
msgid "The graphics context was lost. Reload the page to restore the beams."
msgstr "Le contexte graphique a été perdu. Rechargez la page pour récupérer les rayons."

#: src/editor.ts:70
#, javascript-format
msgid "Beam %1$s: note"
msgstr "Rayon %1$s : note"

#: src/editor.ts:78
#, javascript-format
msgid "Beam %1$s: color"
msgstr "Rayon %1$s : couleur"

#: src/editor.ts:105
#, javascript-format
msgid "%1$s of %2$s custom presets. Changes apply when you save."
msgstr "%1$s préréglages personnalisés sur %2$s. Les modifications s'appliquent à l'enregistrement."

#: src/editor.ts:119
msgid "Untitled"
msgstr "Sans nom"

#: src/editor.ts:172
#, javascript-format
msgid "Preset %1$s"
msgstr "Préréglage %1$s"

#: src/editor.ts:208
#, javascript-format
msgid "Check the names (1–40 characters), short names (1–%1$s), notes, and colors of all presets."
msgstr "Vérifiez les noms (1–40 caractères), les noms courts (1–%1$s), les notes et les couleurs de tous les préréglages."

#: src/index.ts:37 src/template.ts:19
msgid "Laser harp"
msgstr "Harpe laser"

#: src/index.ts:47
msgid "Could not load the instrument. Reload the page to try again."
msgstr "Impossible de charger l'instrument. Rechargez la page pour réessayer."

#: src/presets.ts:14
msgid "Red"
msgstr "Rouge"

#: src/presets.ts:15
msgid "Green"
msgstr "Vert"

#: src/presets.ts:16
msgid "Yellow"
msgstr "Jaune"

#: src/presets.ts:17
msgid "Orange"
msgstr "Orange"

#: src/presets.ts:18
msgid "White"
msgstr "Blanc"

#: src/presets.ts:19
msgid "Blue"
msgstr "Bleu"

#: src/template.ts:25
msgid "Enable sound, then press and hold a beam with the mouse or a finger; you can slide between beams. You can also focus a note and hold Space or Enter. Hovering without pressing makes no sound."
msgstr "Activez le son, puis maintenez un rayon enfoncé avec la souris ou le doigt ; vous pouvez glisser d'un rayon à l'autre. Vous pouvez aussi sélectionner une note et maintenir Espace ou Entrée. Survoler sans appuyer ne produit aucun son."

#: src/template.ts:26
msgid "With the harp focused, hold keys 1 to 0 to play the beams from left to right; 0 is the tenth beam."
msgstr "Avec la harpe sélectionnée, maintenez les touches 1 à 0 pour jouer les rayons de gauche à droite ; 0 correspond au dixième rayon."

#: src/template.ts:30
msgid "PLAY THE LIGHT"
msgstr "JOUEZ LA LUMIÈRE"

#: src/template.ts:33
msgid "Harp notes, from left to right"
msgstr "Notes de la harpe, de gauche à droite"

#: src/template.ts:34
msgid "Select preset"
msgstr "Choisir un préréglage"

#: src/template.ts:36 src/template.ts:42
msgid "Presets"
msgstr "Préréglages"

#: src/template.ts:37
msgid "Volume"
msgstr "Volume"

#: src/template.ts:39
msgid "Loading the instrument…"
msgstr "Chargement de l'instrument…"

#: src/template.ts:40
msgid "Configure presets"
msgstr "Configurer les préréglages"

#: src/template.ts:43
#, javascript-format
msgid "Up to five custom presets of %1$s to %2$s beams. The original RV2 preset keeps its nine notes and is always available."
msgstr "Jusqu'à cinq préréglages personnalisés de %1$s à %2$s rayons. Le préréglage original de RV2 conserve ses neuf notes et reste toujours disponible."

#: src/template.ts:44
msgid "Custom preset"
msgstr "Préréglage personnalisé"

#: src/template.ts:46
msgid "New preset"
msgstr "Nouveau préréglage"

#: src/template.ts:47
msgid "Delete preset"
msgstr "Supprimer le préréglage"

#: src/template.ts:50
msgid "Preset settings"
msgstr "Paramètres du préréglage"

#: src/template.ts:51
msgid "Name"
msgstr "Nom"

#: src/template.ts:52
msgid "Short name (button)"
msgstr "Nom court (bouton)"

#: src/template.ts:53
msgid "Number of beams"
msgstr "Nombre de rayons"

#: src/template.ts:58
msgid "Cancel"
msgstr "Annuler"

#: src/template.ts:59
msgid "Save changes"
msgstr "Enregistrer les modifications"
