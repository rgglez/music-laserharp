      "app" : {
         "Could not restore the local settings; using the initial presets." : {
            "msgctxt" : "app",
            "msgid" : "Could not restore the local settings; using the initial presets.",
            "msgstr" : [
               "Die lokalen Einstellungen konnten nicht wiederhergestellt werden; die Anfangs-Presets werden verwendet."
            ]
         },
         "Laser harp" : {
            "msgstr" : [
               "Laserharfe"
            ],
            "msgid" : "Laser harp",
            "msgctxt" : "app"
         },
         "Green" : {
            "msgid" : "Green",
            "msgctxt" : "app",
            "msgstr" : [
               "Grün"
            ]
         },
         "Enable sound" : {
            "msgctxt" : "app",
            "msgid" : "Enable sound",
            "msgstr" : [
               "Ton aktivieren"
            ]
         },
         "Ready. Play with the note buttons." : {
            "msgstr" : [
               "Bereit. Spiele mit den Notentasten."
            ],
            "msgctxt" : "app",
            "msgid" : "Ready. Play with the note buttons."
         },
         "Preparing the sound…" : {
            "msgstr" : [
               "Ton wird vorbereitet…"
            ],
            "msgid" : "Preparing the sound…",
            "msgctxt" : "app"
         },
         "Volume" : {
            "msgstr" : [
               "Lautstärke"
            ],
            "msgid" : "Volume",
            "msgctxt" : "app"
         },
         "%1$s of %2$s custom presets. Changes apply when you save." : {
            "msgstr" : [
               "%1$s von %2$s eigenen Presets. Änderungen werden beim Speichern übernommen."
            ],
            "msgid" : "%1$s of %2$s custom presets. Changes apply when you save.",
            "msgctxt" : "app"
         },
         "Untitled" : {
            "msgstr" : [
               "Ohne Namen"
            ],
            "msgid" : "Untitled",
            "msgctxt" : "app"
         },
         "Enable sound, then press and hold a beam with the mouse or a finger; you can slide between beams. You can also focus a note and hold Space or Enter. Hovering without pressing makes no sound." : {
            "msgstr" : [
               "Aktiviere den Ton und halte einen Strahl mit der Maus oder dem Finger gedrückt; du kannst zwischen den Strahlen gleiten. Du kannst auch eine Note fokussieren und Leertaste oder Enter halten. Bloßes Überfahren mit der Maus erzeugt keinen Ton."
            ],
            "msgctxt" : "app",
            "msgid" : "Enable sound, then press and hold a beam with the mouse or a finger; you can slide between beams. You can also focus a note and hold Space or Enter. Hovering without pressing makes no sound."
         },
         "Sound is off. Press Enable sound to start." : {
            "msgstr" : [
               "Ton ist aus. Drücke Ton aktivieren, um zu beginnen."
            ],
            "msgctxt" : "app",
            "msgid" : "Sound is off. Press Enable sound to start."
         },
         "PLAY THE LIGHT" : {
            "msgid" : "PLAY THE LIGHT",
            "msgctxt" : "app",
            "msgstr" : [
               "SPIEL DAS LICHT"
            ]
         },
         "Short name (button)" : {
            "msgid" : "Short name (button)",
            "msgctxt" : "app",
            "msgstr" : [
               "Kurzname (Schaltfläche)"
            ]
         },
         "Orange" : {
            "msgstr" : [
               "Orange"
            ],
            "msgid" : "Orange",
            "msgctxt" : "app"
         },
         "With the harp focused, hold keys 1 to 0 to play the beams from left to right; 0 is the tenth beam." : {
            "msgstr" : [
               "Wenn die Harfe fokussiert ist, halte die Tasten 1 bis 0, um die Strahlen von links nach rechts zu spielen; 0 ist der zehnte Strahl."
            ],
            "msgid" : "With the harp focused, hold keys 1 to 0 to play the beams from left to right; 0 is the tenth beam.",
            "msgctxt" : "app"
         },
         "Ready. Press and hold a beam or play a note." : {
            "msgstr" : [
               "Bereit. Halte einen Strahl gedrückt oder spiele eine Note."
            ],
            "msgctxt" : "app",
            "msgid" : "Ready. Press and hold a beam or play a note."
         },
         "Presets" : {
            "msgid" : "Presets",
            "msgctxt" : "app",
            "msgstr" : [
               "Presets"
            ]
         },
         "Could not enable audio. Press Enable sound to try again." : {
            "msgid" : "Could not enable audio. Press Enable sound to try again.",
            "msgctxt" : "app",
            "msgstr" : [
               "Audio konnte nicht aktiviert werden. Drücke Ton aktivieren, um es erneut zu versuchen."
            ]
         },
         "White" : {
            "msgctxt" : "app",
            "msgid" : "White",
            "msgstr" : [
               "Weiß"
            ]
         },
         "Disable sound" : {
            "msgstr" : [
               "Ton deaktivieren"
            ],
            "msgid" : "Disable sound",
            "msgctxt" : "app"
         },
         "Custom preset" : {
            "msgctxt" : "app",
            "msgid" : "Custom preset",
            "msgstr" : [
               "Eigenes Preset"
            ]
         },
         "Beam %1$s: color" : {
            "msgid" : "Beam %1$s: color",
            "msgctxt" : "app",
            "msgstr" : [
               "Strahl %1$s: Farbe"
            ]
         },
         "Blue" : {
            "msgstr" : [
               "Blau"
            ],
            "msgctxt" : "app",
            "msgid" : "Blue"
         },
         "Key %1$s: %2$s" : {
            "msgstr" : [
               "Taste %1$s: %2$s"
            ],
            "msgid" : "Key %1$s: %2$s",
            "msgctxt" : "app"
         },
         "Beam %1$s: note" : {
            "msgstr" : [
               "Strahl %1$s: Note"
            ],
            "msgid" : "Beam %1$s: note",
            "msgctxt" : "app"
         },
         "Check the names (1–40 characters), short names (1–%1$s), notes, and colors of all presets." : {
            "msgstr" : [
               "Prüfe die Namen (1–40 Zeichen), Kurznamen (1–%1$s), Noten und Farben aller Presets."
            ],
            "msgid" : "Check the names (1–40 characters), short names (1–%1$s), notes, and colors of all presets.",
            "msgctxt" : "app"
         },
         "Preset settings" : {
            "msgid" : "Preset settings",
            "msgctxt" : "app",
            "msgstr" : [
               "Preset-Einstellungen"
            ]
         },
         "Loading the instrument…" : {
            "msgstr" : [
               "Instrument wird geladen…"
            ],
            "msgid" : "Loading the instrument…",
            "msgctxt" : "app"
         },
         "Preset %1$s" : {
            "msgctxt" : "app",
            "msgid" : "Preset %1$s",
            "msgstr" : [
               "Preset %1$s"
            ]
         },
         "Delete preset" : {
            "msgctxt" : "app",
