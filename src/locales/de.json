            "msgstr" : [
               "Preset löschen"
            ]
         },
         "Select preset" : {
            "msgstr" : [
               "Preset auswählen"
            ],
            "msgid" : "Select preset",
            "msgctxt" : "app"
         },
         "Number of beams" : {
            "msgstr" : [
               "Anzahl der Strahlen"
            ],
            "msgctxt" : "app",
            "msgid" : "Number of beams"
         },
         "New preset" : {
            "msgid" : "New preset",
            "msgctxt" : "app",
            "msgstr" : [
               "Neues Preset"
            ]
         },
         "Play %1$s, beam %2$s, %3$s" : {
            "msgstr" : [
               "%1$s spielen, Strahl %2$s, %3$s"
            ],
            "msgid" : "Play %1$s, beam %2$s, %3$s",
            "msgctxt" : "app"
         },
         "Yellow" : {
            "msgid" : "Yellow",
            "msgctxt" : "app",
            "msgstr" : [
               "Gelb"
            ]
         },
         "Name" : {
            "msgid" : "Name",
            "msgctxt" : "app",
            "msgstr" : [
               "Name"
            ]
         },
         "Up to five custom presets of %1$s to %2$s beams. The original RV2 preset keeps its nine notes and is always available." : {
            "msgstr" : [
               "Bis zu fünf eigene Presets mit %1$s bis %2$s Strahlen. Das originale RV2-Preset behält seine neun Noten und ist immer verfügbar."
            ],
            "msgctxt" : "app",
            "msgid" : "Up to five custom presets of %1$s to %2$s beams. The original RV2 preset keeps its nine notes and is always available."
         },
         "Red" : {
            "msgctxt" : "app",
            "msgid" : "Red",
            "msgstr" : [
               "Rot"
            ]
         },
         "Save changes" : {
            "msgid" : "Save changes",
            "msgctxt" : "app",
            "msgstr" : [
               "Änderungen speichern"
            ]
         },
         "Changes work on this page, but the browser does not allow saving them for another visit." : {
            "msgid" : "Changes work on this page, but the browser does not allow saving them for another visit.",
            "msgctxt" : "app",
            "msgstr" : [
               "Die Änderungen funktionieren auf dieser Seite, aber der Browser erlaubt nicht, sie für einen späteren Besuch zu speichern."
            ]
         },
         "Cancel" : {
            "msgid" : "Cancel",
            "msgctxt" : "app",
            "msgstr" : [
               "Abbrechen"
            ]
         },
         "WebGL is not available. You can play with the note buttons." : {
            "msgstr" : [
               "WebGL ist nicht verfügbar. Du kannst mit den Notentasten spielen."
            ],
            "msgctxt" : "app",
            "msgid" : "WebGL is not available. You can play with the note buttons."
         },
         "Configure presets" : {
            "msgstr" : [
               "Presets konfigurieren"
            ],
            "msgid" : "Configure presets",
            "msgctxt" : "app"
         },
         "Harp notes, from left to right" : {
            "msgstr" : [
               "Noten der Harfe, von links nach rechts"
            ],
            "msgctxt" : "app",
            "msgid" : "Harp notes, from left to right"
         },
         "Could not load the instrument. Reload the page to try again." : {
            "msgstr" : [
               "Das Instrument konnte nicht geladen werden. Lade die Seite neu, um es erneut zu versuchen."
            ],
            "msgctxt" : "app",
            "msgid" : "Could not load the instrument. Reload the page to try again."
         },
         "The graphics context was lost. Reload the page to restore the beams." : {
            "msgstr" : [
               "Der Grafikkontext ging verloren. Lade die Seite neu, um die Strahlen wiederherzustellen."
            ],
            "msgid" : "The graphics context was lost. Reload the page to restore the beams.",
            "msgctxt" : "app"
         }
      }
